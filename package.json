{
  "name": "real-estate-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Vol 3 — scraping & parsing engine for Tbilisi real-estate listings (ss.ge / Facebook → LLM parsing → Supabase).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "run:ssge": "tsx src/index.ts --source=ssge",
    "run:fb": "tsx src/index.ts --source=fb",
    "reauth:fb": "tsx src/scripts/reauthFb.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.113.0",
    "dotenv": "^17.4.2",
    "openai": "^7.9.0",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
